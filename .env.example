export SIMPLEFIN_ACCESS_URL=https://bridge.simplefin.org/replace-with-issued-access-path  # placeholder; use the claimed URL
export SIMPLEFIN_DAILY_REQUEST_LIMIT=12  # optional; defaults to 24 per database per day
export GOOGLE_SERVICE_ACCOUNT_KEY=/absolute/private/path/service_account.json
export SPREADSHEET_ID=0987654321
export BUDGET_CONFIG=/absolute/private/path/config.toml
export BUDGET_DB_PATH=/absolute/private/path/budget.sqlite3
export BUDGET_STAGING=1  # optional; displays a staging warning banner in the web app
export FLASK_SECRET_KEY=replace-with-a-long-random-secret
